# =====================================================================
# 增量配置：全部取自上游官方库（openwrt base / openwrt packages / openwrt luci）
# 原则：基线 = 上游 defconfig 全量，本文件只追加，不含任何 =n 裁剪项。
# 本文件不含任何本地网络信息（LAN/WiFi/账号/密钥），刷机后由恢复流程注入。
#
# ★ 规矩（2026-11-02 起）：基线一旦确定，必须同步写入本文件，但**不启动构建**。
#   当前对齐基线：BASELINE-AX6-BUILD.md（2026-11-02 定版，校验 61 项）
# =====================================================================

# ---------- 目标设备（红米 AX6 原厂 stock 布局） ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y

# ---------- WireGuard 服务端 ----------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_rpcd-mod-wireguard=y

# ---------- IPv6 双栈（国内可用 / 国外强制走 v4） ----------
# 缺 odhcp6c → 拿不到地址与 PD；缺 odhcpd-ipv6only → LAN 无法下发 RA/DHCPv6
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---------- IPTV 组播转单播 ----------
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y

# ---------- DDNS（Cloudflare） ----------
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---------- Cloudflare Tunnel ----------
CONFIG_PACKAGE_cloudflared=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn=y

# ---------- Tailscale ----------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y

# ---------- A 组：日常体验 ----------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- B 组：稳态与运维 ----------
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_kmod-inet-diag=y

# ---------- 官方库内可得的附加件 ----------
# 每设备流量统计
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
# 无线接入历史（陌生设备可见）
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn=y
# 吞吐与链路测试
CONFIG_PACKAGE_iperf3=y
# ⚠️ 注意：仓库里没有名为 mtr 的实包，真实包名是 mtr-nojson（mtr 只是模板 Makefile）
CONFIG_PACKAGE_mtr-nojson=y
# 定时关无线
CONFIG_PACKAGE_wifischedule=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-i18n-wifischedule-zh-cn=y
# 日志轮转
CONFIG_PACKAGE_logrotate=y

# ---------- 主题（Argon） ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# ---------- 通用工具 ----------
# rtp2httpd 依赖；多个运维脚本使用
CONFIG_PACKAGE_curl=y

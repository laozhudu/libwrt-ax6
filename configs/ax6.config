# =====================================================================
# LibWrt 25.12-nss — Redmi AX6 (stock layout) 满血配置
# 目标平台: qualcommax / ipq807x / aarch64_cortex-a53 / 内核 6.12
# =====================================================================

# ---------- 目标设备 ----------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=""

# ---------- 固件特性 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y
CONFIG_TARGET_UBIFS_OPTIONS="-m 2048 -e 126976"
CONFIG_SIGNED_PACKAGES=n

# ---------- 关键内核模块: 补齐 Clashoo / nikki / dae 依赖 ----------
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-tproxy=y

# ---------- WireGuard 组网 ----------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------- Cloudflare 生态(接口就位, 本体后装) ----------
# CF DDNS: 纯 shell 脚本, 4KB, 编进去
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
# CF Tunnel UI: 4KB, 先备好界面; cloudflared 本体 8.6MB 刷完再 apk add
CONFIG_PACKAGE_luci-app-cloudflared=y
# 优选IP 后装脚本需要 JSON 处理
CONFIG_PACKAGE_jq=y

# ---------- nikki 依赖预置(本体后装, 3.4MB) ----------
CONFIG_PACKAGE_yq=y

# ---------- DDNS (WG 远程访问依赖) ----------
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dnslookup=y
CONFIG_PACKAGE_kmod-nat46=y

# ---------- 内存兜底: 412MB 无 swap, 防 OOM ----------
CONFIG_PACKAGE_zram-swap=y

# ---------- LuCI + 中文 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 常用面板/工具 (沿用原机既有功能) ----------
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-mwan3=y

# ---------- IPTV: rtp2httpd (优先) + msd_lite (回落) ----------
# rtp2httpd: 纯C零依赖, udpxy URL 兼容, FCC 快速换台, RTSP 时移回看, 内置播放器/状态页
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
# msd_lite 保留作 A/B 回落 (仅 73KB)
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_msd_lite=y
# 仅在需要 LAN 侧组播转发时才用; rtp2httpd 转 HTTP 单播时不依赖它
CONFIG_PACKAGE_igmpproxy=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_bash=y

# ---------- 精简: 明确关闭不需要的 ----------
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_kmod-ath10k=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_python3=n
CONFIG_PACKAGE_luci-app-filebrowser=n
